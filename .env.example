# Server-only key used by /api/places/search. Restrict it by IP/origin and API
# in the Geoapify dashboard. Never expose it through a PUBLIC_ variable.
GEOAPIFY_API_KEY=

# Phase 6 planning intent provider. Production defaults to OpenAI; local dev
# defaults to the deterministic mock when this is omitted.
PLANNING_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-4o-mini

# Local alternative. Set PLANNING_AI_PROVIDER=ollama; no OpenAI key is needed.
# Keep Ollama bound to loopback unless you intentionally secure remote access.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_PLANNING_MODEL=qwen3.5:9b
OLLAMA_PLANNING_TIMEOUT_MS=60000

# Optional second-pass ordering of already provider-grounded discovery results.
# Failure or timeout preserves the deterministic ordering; no provider facts are created.
PLANNING_AI_RERANK_ENABLED=false
PLANNING_AI_RERANK_TIMEOUT_MS=12000
PLANNING_AI_RERANK_MAX_CANDIDATES=12

# Development-only detailed in-memory Ask TripFlow trace. Full prompt-like
# content is omitted unless the second flag is explicitly enabled.
TRIPFLOW_AI_DEBUG=false
TRIPFLOW_AI_DEBUG_INCLUDE_CONTENT=false

# The bounded production-safe provenance timeline is always available so source
# badges can link to real events. Detailed payloads still require debug mode.

# Optional SQLite database path.
DATABASE_URL=./data/tripflow.db
